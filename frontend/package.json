{
  "name": "street-vendor-app",
  "version": "1.0.0",
  "description": "Mobile app for street vendors",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-screens": "~3.31.1",
    "react-native-safe-area-context": "4.10.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/stack": "^6.4.2",
    "axios": "^1.6.5",
    "@react-native-picker/picker": "^2.7.1",
    "expo-image-picker": "~14.7.1",
    "expo-location": "~16.5.5",
    "@stripe/stripe-react-native": "^0.35.3",
    "expo-camera": "~14.1.2",
    "react-native-image-crop-picker": "^0.41.4",
    "@react-native-async-storage/async-storage": "^1.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@types/react": "^18.2.42",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.0",
    "typescript": "^5.3.2"
  },
  "private": true,
  "expo": {
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location"
        }
      ]
    ]
  }
}
